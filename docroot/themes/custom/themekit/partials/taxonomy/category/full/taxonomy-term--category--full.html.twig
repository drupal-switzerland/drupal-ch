{% extends "@partials/taxonomy/taxonomy-term.html.twig" %}
{% block term %}
  {% set rendered_content = content|without(
    'field_image',
    'field_heading',
    'description',
    'field_references_limit'
  )
  %}
  <div class="field-banner">
    <div class="field-text">
      {% if site_settings.links.services_link %}
        <a class="link--back" href="{{ site_settings.links.services_link.url }}" >{{ site_settings.links.services_link.title }}</a>
      {% endif %}
      <h1 class="heading">{{ term.field_heading.value }}</h1>

      <div class="field--name-field-intro">
        {{ content.description }}
      </div>

    </div>
    {% if term.field_image.value %}
      <div class="media">
        <span class="frame"></span>
        {{ content.field_image }}
      </div>
    {% endif %}
  </div>

  <div{{ content_attributes.addClass('node__content') }}>
    <div class="field-content">
      {{ rendered_content }}
    </div>
    <div class="field-info">
      {{ content.field_references_limit }}
    </div>
  </div>

  {{ drupal_view('cases', 'category') }}

{% endblock %}
